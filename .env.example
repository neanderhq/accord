# Isolated development PostgreSQL only. Never paste production credentials here.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Development only. Ignored when NODE_ENV=production.
DEV_VERIFICATION_LINKS=1
# Explicit destructive-test/bootstrap target confirmation; isolated development only.
TEAM_ESIGN_DEV_DATABASE=1
# Synthetic bootstrap password supplied locally, at least 12 characters; not a production account.
TEAM_ESIGN_BOOTSTRAP_PASSWORD=
# Transactional email adapter (production). Until both are present, messages stay in the outbox as not configured.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_DISPATCH_ENABLED=0
# Authenticated scheduled job secret (production scheduler; 32+ characters).
JOB_TICK_SECRET=
# Production webhook dispatch and trusted proxy flags.
WEBHOOK_DISPATCH_ENABLED=0
TRUST_PROXY_IP=0
