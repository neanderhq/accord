{
  "name": "accord",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local .neander/migrate.mjs",
    "bootstrap:dev": "tsx scripts/bootstrap.ts",
    "assets:pdf": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "test:auth-schema": "node scripts/verify-auth-schema.mjs",
    "recovery:verify": "tsx scripts/verify-recovery.ts",
    "db:seed": "tsx scripts/seed-template.ts",
    "test:template": "node scripts/verify-template.mjs",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm run check && pnpm run test && pnpm run test:policy && pnpm run build",
    "test:production": "node scripts/verify-template.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.21",
    "@fontsource/inter": "5.3.0",
    "@next/env": "16.4.6",
    "better-auth": "1.7.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "1.23.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "pg": "8.23.0",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.21",
    "drizzle-kit": "0.31.10",
    "playwright": "^1.65.1",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.2",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
